{
  "name": "clean-notes",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pdf-assets.mjs && vite",
    "build": "node scripts/copy-pdf-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:android": "node scripts/copy-pdf-assets.mjs && tsc --noEmit && vite build --mode android",
    "appimage": "npm run build -- --mode desktop && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/commissioner": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.66.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "io.cleannotes.app",
    "productName": "Clean Notes",
    "files": [
      "dist/**",
      "electron/**",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icons/icon-512.png",
      "category": "Office",
      "syncDesktopName": true
    }
  },
  "desktopName": "clean-notes.desktop",
  "license": "MIT"
}
